rules_version = '2';

// Paste into Firebase console → Firestore → Rules → Publish.
// Each player has:
//   users/{uid}                 = { cards: { "OP17-088": 2, ... }, prices: { "OP17-088": { min, avg, max, at }, ... } }
//   users/{uid}/private/learned = { ex: { "OP17-096": ["<fingerprint>", ...] } }   what they taught the scanner
// and only that player can read or change them.
// learned/{set} = the shared base taught by the teacher account (TEACHER_UID in src/backend.ts):
// every signed-in player can read it, only the teacher can change it. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null && request.auth.uid == 'CEDVsWBICxWmAPjp7PPb1TaR2fh2';
    }
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cards', 'prices'])
        && request.resource.data.get('cards', {}) is map
        && request.resource.data.get('cards', {}).size() <= 5000
        && request.resource.data.get('prices', {}) is map
        && request.resource.data.get('prices', {}).size() <= 5000;
    }
    match /users/{uid}/private/learned {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ex'])
        && request.resource.data.ex is map
        && request.resource.data.ex.size() <= 1500;
    }
    match /learned/{set} {
      allow read: if request.auth != null;
      allow delete: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['ex'])
        && request.resource.data.ex is map
        && request.resource.data.ex.size() <= 500;
    }
  }
}
